# Variables del servicio Docker Compose en Easypanel (pestaña de entorno, con «Create .env file» activado).
# Compose interpreta `$` en los valores: si SECRET_KEY lleva `$`, ponla ENTRE COMILLAS SIMPLES (como abajo);
# sin comillas, `$abc` se sustituye por vacío y la clave queda alterada sin avisar.

SECRET_KEY='cambia-esto-por-una-clave-larga-y-aleatoria'
ALLOWED_HOSTS=facturia.xyz,www.facturia.xyz

# --- PostgreSQL de Easypanel (servicio aparte) ---
# Host interno: el que muestra Easypanel en la pantalla de conexión del servicio Postgres.
POSTGRES_HOST=
# Red de Docker donde están los servicios de Easypanel (comprobar con `docker network ls` en el servidor).
# EASYPANEL_NETWORK=easypanel
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Cloudflare R2 (jurisdicción UE) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com

# --- Extracción con Claude ---
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-haiku-5-5
# EXTRACTION_FALLBACK_MODEL=claude-sonnet-5-5
# EXTRACTION_AUTO_APPROVE=False
# EXTRACTION_MAX_TOKENS=8192      # subir (p. ej. 16000) si hay facturas muy largas
# UPLOAD_MAX_FILE_MB=20

# --- Ajustes opcionales ---
# CSRF_TRUSTED_ORIGINS=
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=180

# LOG_LEVEL=INFO

# Email saliente (facturas y presupuestos). OBLIGATORIO en producción: sin EMAIL_HOST la app no arranca.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FacturIA <facturas@tu-dominio.com>

# URL pública (enlaces a presupuestos), OBLIGATORIA y distinta de localhost: https://app.tu-dominio.com
PUBLIC_BASE_URL=
